{
	"name": "mensa",
	"module": "src/main.ts",
	"type": "module",
	"private": false,
	"version": "0.3.1",
	"scripts": {
		"dev": "bun run --watch src/main.ts",
		"build": "bun run src/build.ts",
		"archive": "bun run src/archive.ts",
		"install:linux": "bash dist/linstall.sh",
		"install:macos": "bash dist/minstall.sh",
		"format": "bunx biome check --write src/"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/bun": "latest"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@opentui/core": "^0.6.8",
		"nanostores": "^1.5.5"
	}
}
