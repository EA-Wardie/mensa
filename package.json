{
	"name": "mensa",
	"module": "src/main.ts",
	"type": "module",
	"private": false,
	"version": "0.2.4",
	"scripts": {
		"dev": "bun run --watch src/main.ts",
		"build": "bun run src/build.ts",
		"archive": "bun run src/archive.ts",
		"install:app": "bash dist/install.sh",
		"format": "bunx biome check --write src/"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@opentui/core": "^0.6.6",
		"nanostores": "^1.5.5"
	}
}
